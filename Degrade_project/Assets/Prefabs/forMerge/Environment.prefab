    - target: {fileID: 5781506425624133114, guid: 75efcaeac90bb0648bf1f9ef1698ef5d, type: 3}
      propertyPath: NewPlayerDialogues.Array.size
      value: 11
      objectReference: {fileID: 0}
    - target: {fileID: 5781506425624133114, guid: 75efcaeac90bb0648bf1f9ef1698ef5d, type: 3}
      propertyPath: NewPlayerDialogues.Array.data[0].dialogueText
      value: "\u201C\u7EC4\u957F\uFF0C\u6211\u521A\u6536\u5230\u5173\u4E8E\u7AF9\u53F6\u6751\u6751\u53E3\u90A3\u5806\u5783\u573E\u7684\u62A5\u544A\uFF0C\u597D\u50CF\u4E0D\u662F\u666E\u901A\u7684\u5783\u573E\u6C61\u67D3\u3002\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5781506425624133114, guid: 75efcaeac90bb0648bf1f9ef1698ef5d, type: 3}
      propertyPath: NewPlayerDialogues.Array.data[1].dialogueText
      value: "\u201C\u662F\u7684\uFF0C\u6211\u4EEC\u5DF2\u7ECF\u6536\u5230\u591A\u4E2A\u7C7B\u4F3C\u7684\u62A5\u544A\u3002\u4E0D\u4EC5\u4EC5\u662F\u90A3\u4E2A\u5783\u573E\u5806\uFF0C\u4E0E\u6700\u8FD1\u53D1\u751F\u7684\u2018\u964D\u89E3\u2019\u73B0\u8C61\u6709\u5173\u3002\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5781506425624133114, guid: 75efcaeac90bb0648bf1f9ef1698ef5d, type: 3}
      propertyPath: NewPlayerDialogues.Array.data[2].dialogueText
      value: "\u201C\u2018\u964D\u89E3\u2019\u73B0\u8C61\uFF1F\u90A3\u662F\u4EC0\u4E48\uFF1F\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5781506425624133114, guid: 75efcaeac90bb0648bf1f9ef1698ef5d, type: 3}
      propertyPath: NewPlayerDialogues.Array.data[3].dialogueText
      value: "\u201C\u2018\u964D\u89E3\u2019\u662F\u8C03\u67E5\u5458\u4EEC\u7528\u6765\u63CF\u8FF0\u8FD9\u4E9B\u73B0\u8C61\u7684\u9ED1\u8BDD\uFF0C\u4F60\u6CA1\u542C\u5176\u4ED6\u4EBA\u8BF4\u8FC7\u5417\uFF1F\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5781506425624133114, guid: 75efcaeac90bb0648bf1f9ef1698ef5d, type: 3}
      propertyPath: NewPlayerDialogues.Array.data[4].dialogueText
      value: "\u201C\u6709\u4E9B\u7269\u54C1\u5728\u6BEB\u65E0\u9884\u5146\u7684\u60C5\u51B5\u4E0B\uFF0C\u7A81\u7136\u53D8\u5F97\u4E0D\u518D\u662F\u5B83\u4EEC\u539F\u672C\u7684\u6837\u5B50\u2014\u2014\u98DF\u7269\u8150\u70C2\u3001\u7535\u5B50\u8BBE\u5907\u7834\u635F\u3001\u751A\u81F3\u6574\u4E2A\u751F\u6001\u7CFB\u7EDF\u7684\u5D29\u584C\uFF0C\u5C31\u50CF\u662F\u67D0\u79CD\u4E0D\u53EF\u89C1\u7684\u529B\u91CF\u5728\u52A0\u901F\u5B83\u4EEC\u7684\u8870\u8D25\u3002\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5781506425624133114, guid: 75efcaeac90bb0648bf1f9ef1698ef5d, type: 3}
      propertyPath: NewPlayerDialogues.Array.data[5].dialogueText
      value: "\u201C\u6240\u4EE5\uFF0C\u8FD9\u4E9B\u2018\u964D\u89E3\u2019\u73B0\u8C61\u7684\u53D1\u751F\uFF0C\u4E0D\u662F\u666E\u901A\u7684\u73AF\u5883\u6C61\u67D3\u6216\u81EA\u7136\u635F\u8017\uFF1F\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5781506425624133114, guid: 75efcaeac90bb0648bf1f9ef1698ef5d, type: 3}
      propertyPath: NewPlayerDialogues.Array.data[6].dialogueText
      value: "\u201C\u6CA1\u9519\u3002\u6211\u4EEC\u65E0\u6CD5\u6392\u9664\u8FD9\u4E9B\u53D8\u5316\u53EF\u80FD\u4E0E\u67D0\u79CD\u6211\u4EEC\u65E0\u6CD5\u8BC6\u522B\u7684\u529B\u91CF\u6216\u73B0\u8C61\u6709\u5173\u3002\u6240\u4EE5\u4F60\u9700\u8981\u53BB\u7AF9\u53F6\u6751\u8C03\u67E5\uFF0C\u770B\u770B\u662F\u5426\u80FD\u53D1\u73B0\u4EFB\u4F55\u5F02\u5E38\u7684\u7EBF\u7D22\u3002\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5781506425624133114, guid: 75efcaeac90bb0648bf1f9ef1698ef5d, type: 3}
      propertyPath: NewPlayerDialogues.Array.data[7].dialogueText
      value: "\u201C\u597D\u7684\uFF0C\u7EC4\u957F\u3002\u6211\u4F1A\u5C3D\u5168\u529B\u8C03\u67E5\u3002\u6211\u4EEC\u4E0D\u80FD\u8BA9\u8FD9\u4E9B\u2018\u964D\u89E3\u2019\u73B0\u8C61\u8513\u5EF6\u5F00\u6765\u3002\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5781506425624133114, guid: 75efcaeac90bb0648bf1f9ef1698ef5d, type: 3}
      propertyPath: NewPlayerDialogues.Array.data[8].dialogueText
      value: "\u201C\u8BB0\u4F4F\uFF0C\u60C5\u51B5\u53EF\u80FD\u6BD4\u4F60\u60F3\u8C61\u7684\u8FD8\u8981\u590D\u6742\u3002\u8C03\u67E5\u8FC7\u7A0B\u4E2D\u8981\u65F6\u523B\u4FDD\u6301\u8B66\u89C9\uFF0C\u786E\u4FDD\u80FD\u591F\u6536\u96C6\u5230\u6709\u4EF7\u503C\u7684\u7EBF\u7D22\u3002\u8FD9\u4E2A\u4EFB\u52A1\u4E0D\u4EC5\u5173\u4E4E\u73AF\u5883\u95EE\u9898\uFF0C\u66F4\u5173\u4E4E\u6211\u4EEC\u7684\u672A\u6765\u3002\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5781506425624133114, guid: 75efcaeac90bb0648bf1f9ef1698ef5d, type: 3}
      propertyPath: NewPlayerDialogues.Array.data[9].dialogueText
      value: "\u201C\u5BF9\u4E86\uFF0C\u8C03\u67E5\u5458\uFF0C\u522B\u5FD8\u4E86\u968F\u65F6\u67E5\u770B\u4EFB\u52A1\u65E5\u5FD7\uFF0C\u90A3\u91CC\u4F1A\u66F4\u65B0\u4F60\u5F53\u524D\u7684\u76EE\u6807\u3002\u8FD8\u6709\uFF0C\u4F60\u7684\u88C5\u5907\u4E2D\u6709\u4E2A\u65F6\u5149\u624B\u8868\uFF0C\u80FD\u56DE\u6EAF\u65F6\u95F4\u6765\u534F\u52A9\u4F60\u7684\u8C03\u67E5\uFF0C\u5728\u5408\u9002\u7684\u65F6\u673A\u4F7F\u7528\u5B83\u3002\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5781506425624133114, guid: 75efcaeac90bb0648bf1f9ef1698ef5d, type: 3}
      propertyPath: NewPlayerDialogues.Array.data[10].dialogueText
      value: "\u201C\u4EFB\u52A1\u5B8C\u6210\u540E\uFF0C\u8BF7\u7ACB\u5373\u56DE\u5230\u603B\u90E8\u62A5\u544A\u3002\u795D\u4F60\u597D\u8FD0\uFF0C\u4FDD\u6301\u8B66\u89C9\u3002\u201D"
      objectReference: {fileID: 0}
