--- !u!114 &6689683730164790409
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7133868841672786823}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4134cadcd65b3004dbeb96a39e1765f1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  fadeSpeed: 1
  isTalking: 0
  villageNpcDialogues:
  - isSpeakerPlayer: 0
    dialogueText: "\u201C\u4F60\u7EC8\u4E8E\u6765\u4E86\uFF01\u8FD9\u5730\u65B9\u8D8A\u6765\u8D8A\u4E0D\u5BF9\u52B2\u4E86\u3002\u6751\u53E3\u90A3\u5806\u571F\u5806\uFF0C\u5168\u90FD\u53D8\u6210\u4E86\u5783\u573E\uFF01\u4F60\u5F97\u53BB\u770B\u770B\uFF0C\u6050\u6015\u95EE\u9898\u4E0D\u7B80\u5355\u3002\u201D"
  - isSpeakerPlayer: 1
    dialogueText: "\u201C\u571F\u5806\u600E\u4E48\u4F1A\u53D8\u6210\u5783\u573E\uFF1F\u4EE5\u524D\u5C31\u662F\u8FD9\u6837\u7684\u5417\uFF1F\u201D"
  - isSpeakerPlayer: 0
    dialogueText: "\u201C\u51E0\u4E2A\u6708\u524D\u8FD9\u91CC\u8FD8\u6B63\u5E38\uFF0C\u540E\u6765\u571F\u5806\u5C31\u5F00\u59CB\u53D8\u4E86\uFF0C\u8D8A\u6765\u8D8A\u5927\uFF0C\u8D8A\u6765\u8D8A\u81ED\u3002\u6211\u4EEC\u6000\u7591\u8FD9\u548C\u6700\u8FD1\u7684\u6C34\u6E90\u6C61\u67D3\u6709\u5173\u3002\u6211\u542C\u8BF4\u571F\u5806\u4E0B\u85CF\u7740\u4E1C\u897F\uFF0C\u4F60\u53BB\u770B\u770B\uFF0C\u53EF\u80FD\u80FD\u53D1\u73B0\u70B9\u4EC0\u4E48\u3002\u201D"
  - isSpeakerPlayer: 1
    dialogueText: "\u201C\u597D\uFF0C\u6211\u4F1A\u53BB\u8C03\u67E5\u3002\u8BF4\u4E0D\u5B9A\u80FD\u627E\u5230\u4E9B\u4EC0\u4E48\u7EBF\u7D22\u3002\u201D"
  villageNpcVisitedDialogues:
  - isSpeakerPlayer: 0
    dialogueText: "\u201C\u54E6\uFF0C\u4F60\u53C8\u56DE\u6765\u4E86\uFF0C\u96BE\u9053\u6211\u6CA1\u8BF4\u8FC7\uFF1F\u571F\u5806\u7684\u4E8B\u60C5\u771F\u5F97\u597D\u597D\u770B\u770B\u3002\u611F\u89C9\u6BCF\u6B21\u8DDF\u4F60\u8BF4\u8FD9\u4E9B\uFF0C\u60C5\u51B5\u5C31\u53D8\u5F97\u66F4\u7CDF\u3002\u201D"
  - isSpeakerPlayer: 1
    dialogueText: "\u201C\u4E00\u76F4\u90FD\u662F\u8FD9\u6837\u7684\u5417\uFF1F\u201D"
  - isSpeakerPlayer: 0
    dialogueText: "\u201C\u51E0\u4E2A\u6708\u524D\u8FD9\u91CC\u4E00\u5207\u90FD\u8FD8\u6B63\u5E38\uFF0C\u6CA1\u60F3\u5230\u540E\u6765\u571F\u5806\u5C31\u53D8\u5F97\u8D8A\u6765\u8D8A\u5927\uFF0C\u8D8A\u6765\u8D8A\u81ED\u3002\u6211\u4EEC\u6000\u7591\u8FD9\u548C\u6700\u8FD1\u7684\u6C34\u6E90\u6C61\u67D3\u4E5F\u6709\u5173\u3002\u6211\u542C\u8BF4\u571F\u5806\u4E0B\u85CF\u7740\u4E1C\u897F\uFF0C\u4F60\u53BB\u770B\u770B\uFF0C\u53EF\u80FD\u80FD\u53D1\u73B0\u70B9\u4EC0\u4E48\u3002\u201D"
  - isSpeakerPlayer: 1
    dialogueText: "\u201C\u597D\uFF0C\u6211\u4F1A\u53BB\u8C03\u67E5\u3002\u8BF4\u4E0D\u5B9A\u80FD\u627E\u5230\u4E9B\u4EC0\u4E48\u7EBF\u7D22\u3002\u201D"
  isVisited: 0
