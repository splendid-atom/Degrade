  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b601d1f3abd12c6449a13ac0a658c6f9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  targetSceneName: BambooMazeScene
  playerStartObjectName: PlayerStartPos
  fadeCanvasGroup: {fileID: 0}
  bambooMazeDialogues:
  - isSpeakerPlayer: 0
    dialogueText: " \u201C\u563F\uFF0C\u8C03\u67E5\u5458\uFF0C\u4F60\u5230\u7AF9\u6797\u4E86\u5417\uFF1F\u6211\u542C\u8BF4\u524D\u4E00\u4E2A\u8C03\u67E5\u5458\u8FDB\u53BB\u540E\uFF0C\u5DEE\u70B9\u8FF7\u4E86\u8DEF\uFF0C\u6574\u6574\u4E00\u5929\u624D\u51FA\u6765\u3002\u201D"
  - isSpeakerPlayer: 1
    dialogueText: " \u201C\u770B\u6765\u4ED6\u6CA1\u5E26\u56DE\u4EC0\u4E48\u91CD\u8981\u7684\u7EBF\u7D22\uFF1F\u201D"
  - isSpeakerPlayer: 0
    dialogueText: " \u201C\u9664\u4E86\u7AF9\u5C51\u548C\u4E00\u5806\u2018\u964D\u89E3\u2019\u73B0\u8C61\u7684\u8BC1\u636E\uFF0C\u6CA1\u6709\u522B\u7684\u3002\u7AF9\u6797\u53EF\u4E0D\u662F\u7B80\u5355\u7684\u5730\u65B9\u3002\u201D"
  - isSpeakerPlayer: 1
    dialogueText: "\u201C\u597D\u5427\uFF0C\u6211\u4F1A\u5C0F\u5FC3\u7684\uFF0C\u7EC4\u957F\u3002\u201D"
  - isSpeakerPlayer: 0
    dialogueText: "\u201C\u8BB0\u4F4F\uFF0C\u5982\u679C\u5B9E\u5728\u8BA4\u4E0D\u6E05\u8DEF\uFF0C\u65F6\u5149\u624B\u8868\u53EF\u4EE5\u5E2E\u4F60\u4E00\u628A\uFF0C\u4F46\u5B83\u6BCF\u6BB5\u65F6\u95F4\u53EA\u80FD\u7528\u4E00\u6B21\u3002\u201D"
  isInMazeSwitchTrigger: 0
  isStartSwitchScene: 0
