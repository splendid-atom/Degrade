  HeepDialogues:
  - isSpeakerPlayer: 1
    dialogueText: "\u201C\u8FD9\u5730\u65B9\u597D\u50CF\u6CA1\u4EC0\u4E48\u7279\u522B\u7684\uFF0C\u571F\u5806\u91CC\u9762\u6CA1\u6709\u4EFB\u4F55\u5783\u573E\uFF0C\u600E\u4E48\u56DE\u4E8B?\u201D"
  - isSpeakerPlayer: 1
    dialogueText: "\u201C\u8FD9\u2026\u2026\u600E\u4E48\u56DE\u4E8B?\u571F\u5806\u5C45\u7136\u5728\u9707\u52A8\uFF0C\u5783\u573E\u4ECE\u5730\u4E0B\u5192\u51FA\u6765!\u8FD9\u4E0D\u6B63\u5E38\u2026\u2026\u201D"
  - isSpeakerPlayer: 1
    dialogueText: "\u201C\u8FD9\u4E9B\u5783\u573E\u770B\u8D77\u6765\u4E0D\u50CF\u662F\u81EA\u7136\u5806\u79EF\u7684\uFF0C\u662F\u4E0D\u662F\u6709\u67D0\u79CD\u529B\u91CF\u5728\u63A8\u52A8\u5B83\u4EEC?\u201D"
  - isSpeakerPlayer: 1
    dialogueText: "\u201C\u4ECE\u521A\u624D\u5F00\u59CB\uFF0C\u5C31\u4E00\u76F4\u6709\u6EF4\u7B54\u6EF4\u7B54\u7684<color=#FF4757><b>\u58F0\u97F3</b></color>\u2026\u2026\u662F\u949F\u58F0\uFF1F\u5230\u5E95\u4ECE\u54EA\u91CC\u4F20\u6765\u7684?\u201D"
