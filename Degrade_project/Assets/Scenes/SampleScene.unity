    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: npcName
      value: "\u7EC4\u957F"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: isTalking
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.size
      value: 16
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[0].dialogueText
      value: "\u201C\u7EC4\u957F\uFF0C\u6211\u5DF2\u7ECF\u6536\u96C6\u5230\u4E86\u4E09\u4E2A\u65F6\u7A7A\u788E\u7247\u3002\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[1].dialogueText
      value: "\u201C\u8BA9\u6211\u770B\u770B\u3002\u679C\u7136\uFF0C\u8FD9\u4E9B\u788E\u7247\u7684\u80FD\u91CF\u6CE2\u52A8\u9AD8\u5EA6\u4E00\u81F4\u2026\u2026\u7B49\u4E00\u4E0B\u2026\u2026\u201D\uFF08\u7EC4\u957F\u7709\u5934\u7D27\u76B1\uFF0C\u62FF\u51FA\u68C0\u6D4B\u4EEA\u5668\u626B\u63CF\uFF09"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[2].dialogueText
      value: "\u201C\u600E\u4E48\u4E86\uFF1F\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[3].dialogueText
      value: "\u201C\u8FD9\u4E9B\u788E\u7247\u5E76\u4E0D\u53EA\u662F\u666E\u901A\u7684\u4F20\u9001\u95E8\u6B8B\u9AB8\uFF0C\u5B83\u4EEC\u5F7C\u6B64\u4E4B\u95F4\u5B58\u5728\u67D0\u79CD\u5171\u632F\u6548\u5E94\u3002\u201D\uFF08\u7EC4\u957F\u8FC5\u901F\u5728\u63A7\u5236\u53F0\u4E0A\u8F93\u5165\u6570\u636E\uFF09"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[4].dialogueText
      value: "\u201C\u5982\u679C\u6211\u4EEC\u5C06\u5B83\u4EEC\u62FC\u5408\uFF0C\u5B83\u4EEC\u4F1A\u91CD\u65B0\u6784\u5EFA\u51FA\u4E00\u4E2A\u5B8C\u6574\u7684\u4F20\u9001\u95E8\u2014\u2014\u800C\u4E14\uFF0C\u8FD9\u4E2A\u4F20\u9001\u95E8\u7684\u76EE\u6807\u2026\u2026\u4F3C\u4E4E\u662F\u901A\u5F80\u53E6\u4E00\u4E2A\u4E16\u754C\u3002\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[5].dialogueText
      value: "\u201C\u4EC0\u4E48\uFF1F\u8FD9\u4E9B\u788E\u7247\u8FD8\u80FD\u91CD\u65B0\u6784\u6210\u4F20\u9001\u95E8\uFF1F\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[6].dialogueText
      value: "\u201C\u662F\u7684\uFF0C\u5B83\u4EEC\u50CF\u662F\u67D0\u79CD\u7279\u6B8A\u7684\u65F6\u7A7A\u94A5\u5319\uFF0C\u53EA\u6709\u5F53\u5B83\u4EEC\u9F50\u805A\u65F6\uFF0C\u624D\u80FD\u6FC0\u6D3B\u771F\u6B63\u7684\u76EE\u7684\u5730\u3002\u201D\uFF08\u7EC4\u957F\u505C\u987F\u7247\u523B\uFF0C\u4E25\u8083\u5730\u770B\u5411\u73A9\u5BB6\uFF09"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[7].dialogueText
      value: "\u201C\u8FD9\u4E5F\u610F\u5473\u7740\uFF0C\u4E4B\u524D\u90A3\u4E9B\u4F20\u9001\u95E8\u53EF\u80FD\u662F\u67D0\u4E2A\u672A\u77E5\u52BF\u529B\u6545\u610F\u5F00\u542F\u7684\u3002\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[8].dialogueText
      value: "\u201C\u6240\u4EE5\u2026\u2026\u4F60\u7684\u610F\u601D\u662F\uFF0C\u6211\u4EEC\u4E4B\u524D\u8C03\u67E5\u7684\u4E00\u5207\uFF0C\u80CC\u540E\u8FD8\u6709\u66F4\u5927\u7684\u79D8\u5BC6\uFF1F\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[9].dialogueText
      value: "\u201C\u5F88\u6709\u53EF\u80FD\u3002\u800C\u4E14\uFF0C\u5982\u679C\u8FD9\u4E9B\u788E\u7247\u901A\u5411\u540C\u4E00\u4E2A\u4E16\u754C\uFF0C\u90A3\u4E48\u90A3\u4E2A\u4E16\u754C\u4E00\u5B9A\u9690\u85CF\u7740\u4F20\u9001\u95E8\u7684\u79D8\u5BC6\u3002\u6211\u4EEC\u4E0D\u80FD\u5750\u89C6\u4E0D\u7406\u3002\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[10].dialogueText
      value: "\u201C\u90A3\u63A5\u4E0B\u6765\u600E\u4E48\u529E\uFF1F\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[11].dialogueText
      value: "\u201C\u6211\u4EEC\u9700\u8981\u4F60\u4EB2\u81EA\u7A7F\u8FC7\u8FD9\u4E2A\u4F20\u9001\u95E8\uFF0C\u53BB\u8C03\u67E5\u53E6\u4E00\u7AEF\u7684\u4E16\u754C\u3002\u201D\uFF08\u7EC4\u957F\u76EF\u7740\u73A9\u5BB6\uFF0C\u8BED\u6C14\u575A\u5B9A\uFF09"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[12].dialogueText
      value: "\u201C\u8FD9\u6B21\u7684\u4EFB\u52A1\u5371\u9669\u672A\u77E5\uFF0C\u4F46\u4F60\u662F\u552F\u4E00\u4E00\u4E2A\u6210\u529F\u6536\u96C6\u788E\u7247\u3001\u7406\u89E3\u4F20\u9001\u95E8\u8FD0\u4F5C\u7684\u4EBA\u3002\u5982\u679C\u8BA9\u522B\u4EBA\u53BB\uFF0C\u53EF\u80FD\u6839\u672C\u65E0\u6CD5\u5E94\u5BF9\u7A81\u53D1\u60C5\u51B5\u3002\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[13].dialogueText
      value: "\u201C\u2026\u2026\u770B\u6765\uFF0C\u6211\u522B\u65E0\u9009\u62E9\u3002\uFF08\u73A9\u5BB6\u63E1\u7D27\u62F3\u5934\uFF0C\u773C\u795E\u575A\u5B9A\uFF09\u597D\uFF0C\u6211\u4F1A\u8FDB\u53BB\u4E00\u63A2\u7A76\u7ADF\u3002\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[14].dialogueText
      value: "\u201C\u5F88\u597D\uFF0C\u6211\u4EEC\u9A6C\u4E0A\u5F00\u59CB\u51C6\u5907\u3002\u4F60\u6709\u6700\u540E\u7684\u51C6\u5907\u65F6\u95F4\uFF0C\u4E00\u65E6\u4F20\u9001\u95E8\u5F00\u542F\uFF0C\u65E0\u6CD5\u4FDD\u8BC1\u4F60\u4EC0\u4E48\u65F6\u5019\u80FD\u56DE\u6765\u3002\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[15].dialogueText
      value: "\u201C\u6211\u660E\u767D\uFF0C\u6211\u4F1A\u5C3D\u5FEB\u51C6\u5907\u597D\u3002\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8476548280563758415, guid: 3d16cea878df701429be3eba9f92edbf, type: 3}
      propertyPath: CollectedTimePieceDialogues.Array.data[0].isSpeakerPlayer
